# Secrets and personal settings never enter git (12/N10, 05/SG12)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.claude/settings.local.json
# Local-only signing keys for dev tokens, and uploaded files (never committed)
.dev-keys/
.uploads/
# Deploy records written where scripts/deploy.py runs (the real record is STATE.md and the job summary)
.deploy/
# Pinned scanners (make tools) and the SBOMs they write
.tools/
sbom-*.cdx.json
# Harness runtime state (session records, breadcrumbs, last check result)
.claude/state/
# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
# Node
node_modules/
.next/
dist/
next-env.d.ts
*.tsbuildinfo
test-results/
playwright-report/
# OS
.DS_Store
