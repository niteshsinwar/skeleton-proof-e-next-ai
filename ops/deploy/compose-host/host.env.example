# The host env file for one environment of the Docker host target: NAMES only here, values on the host (or in the
# GitHub environment's DEPLOY_ENV_FILE secret), never in git (07/O1, 05/SG12). scripts/deploy.py refuses a file
# inside the repository, a file others can read, and one whose APP_ENV differs from the environment it deploys.
# Copy to e.g. /etc/skeleton-proof-e-next-ai/production.env, `chmod 600`, and fill in every value.

# Where traffic arrives: the TLS proxy in front forwards to these (the project's DNS and certificates, plans/b5 §3).
DEPLOY_BASE_URL=https://api.example.invalid
DEPLOY_WEB_URL=https://app.example.invalid
BIND_ADDRESS=127.0.0.1
API_PORT=8000
WEB_PORT=3000

# The database: "managed" (a provider's Postgres 18, reached by the URLs below) or "bundled" (the postgres service
# in this compose file, with a named volume; scripts/deploy.py creates the app's login role from the URL).
DEPLOY_DATABASE=managed
# The schema owner: used only by `migrate` and `downgrade` (02/Z10).
APP_MIGRATION_DATABASE_URL=postgresql+psycopg://app_owner:CHANGE-ME@db.example.invalid:5432/app
# The app's login role: a member of app_user and app_worker, never the owner.
APP_DATABASE_URL=postgresql+psycopg://app_runtime:CHANGE-ME@db.example.invalid:5432/app

# A host folder holding jwks.json (public keys only: go-live refuses a private one).
APP_CONFIG_DIR=/etc/skeleton-proof-e-next-ai/config
APP_AUTH_ISSUER=https://issuer.example.invalid
APP_AUTH_AUDIENCE=app-api
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
APP_MCP_SECRETS_KEY=
APP_MCP_RESOURCE_URL=https://api.example.invalid/mcp
APP_MCP_ALLOWED_HOSTS=["api.example.invalid"]
APP_WEBHOOK_SECRETS={}
OIDC_ISSUER=https://issuer.example.invalid
OIDC_CLIENT_ID=web
OIDC_CLIENT_SECRET=
SESSION_SECRET=
APP_BASE_URL=https://app.example.invalid
