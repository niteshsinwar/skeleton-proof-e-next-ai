# Every setting the project reads, with local-only defaults and never a real secret (README start checklist).
# Copy to .env for local runs; .env is gitignored and excluded from every image (12/N10).
# Process settings only: business configuration is versioned data in apps/api/config/ (02/B5, 02/D9).
# Unknown APP_ keys are rejected at start (fail closed).

# Backend (apps/api)
APP_ENV=local
APP_BUILD_SHA=
APP_DATABASE_URL=postgresql+psycopg://app_owner:local-only-not-a-secret@127.0.0.1:5432/app
APP_AUTH_JWKS_FILE=.dev-keys/jwks.json
# With the web app, the API trusts the local mock issuer (make dev-issuer); dev tokens use --issuer to match.
APP_AUTH_ISSUER=http://127.0.0.1:9400
APP_AUTH_AUDIENCE=app-api
APP_RATE_LIMIT_STORE=postgres

# The product AI: ai/models.yaml names each provider's credential. Empty means AI runs off and the product still works
# (01/R5). Real keys live in the secret manager, never in git or a deployed tree (05/SG12).
ANTHROPIC_API_KEY=
# Embeddings for retrieval (ai/models.yaml `embeddings`). Empty means search runs on full text only, and says so.
GEMINI_API_KEY=
# Seals each tenant's outside MCP server secrets (32 random bytes, base64: `openssl rand -base64 32`). Empty: no outside
# server can be connected. Production refuses to start with servers configured and no key.
APP_MCP_SECRETS_KEY=

# Inbound webhooks (02/I4): JSON of source -> signing secrets; real values live in the secret manager.
# APP_WEBHOOK_SECRETS={"billing": ["whsec_<base64 secret>"]}

# Web app (apps/web, read by `make dev-web`). Local-only values; production sets real ones in its secret manager.
API_URL=http://127.0.0.1:8000
OIDC_ISSUER=http://127.0.0.1:9400
OIDC_CLIENT_ID=web
OIDC_CLIENT_SECRET=local-dev-secret
SESSION_SECRET=local-only-session-secret-at-least-32-chars
APP_BASE_URL=http://127.0.0.1:3000
APP_CATALOGUE=1

# Error monitoring with Sentry (03/F48), chosen at render time. Empty: off, and the built-in beacon is used.
# The browser's DSN is public and baked in at build (docker build --build-arg SENTRY_DSN=...); the server's is read
# at run time. Source maps upload only where the image is built with a token, never from a laptop by accident.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
